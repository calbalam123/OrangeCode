{
  "출력": {
    "prefix": "출력",
    "body": [
      "출력하기(\"$1\")"
    ],
    "description": "문자열이나 값을 출력합니다"
  },
  "변수": {
    "prefix": "변수",
    "body": [
      "변수 ${1:이름} = ${2:\"값\"}"
    ],
    "description": "변수를 선언합니다"
  },
  "조건문": {
    "prefix": "만약",
    "body": [
      "만약 ${1:조건} 라면 {",
      "    $0",
      "} 아니면 {",
      "    ",
      "}"
    ],
    "description": "만약/아니면 조건문"
  },
  "반복문": {
    "prefix": "반복",
    "body": [
      "반복하기 ${1:3}번 {",
      "    $0",
      "}"
    ],
    "description": "정해진 횟수만큼 반복합니다"
  },
  "입력받기": {
    "prefix": "입력받기",
    "body": [
      "입력받기 ${1:사용자입력} \"${2:내용을 입력하세요}\""
    ],
    "description": "콘솔에서 문자열을 입력받습니다"
  },
  "파일 저장": {
    "prefix": "파일저장",
    "body": [
      "파일에쓰기 \"${1:data.txt}\" ${2:내용}"
    ],
    "description": "텍스트 파일에 내용을 저장합니다"
  },
  "파일 읽기": {
    "prefix": "파일읽기",
    "body": [
      "파일읽기 ${1:내용} \"${2:data.txt}\""
    ],
    "description": "텍스트 파일에서 내용을 읽습니다"
  },
  "GUI 창": {
    "prefix": "창만들기",
    "body": [
      "창 만들기 \"${1:내 프로그램}\" {",
      "    너비 720",
      "    높이 460",
      "    글자 \"${2:안녕하세요}\"",
      "    버튼 \"${3:확인}\" 클릭하면 {",
      "        출력하기(\"클릭!\")",
      "    }",
      "}"
    ],
    "description": "기본 데스크톱 GUI 창을 만듭니다"
  },
  "함수": {
    "prefix": "함수",
    "body": [
      "함수 ${1:이름}(${2:인자}) {",
      "    $0",
      "}"
    ],
    "description": "함수를 정의합니다"
  }
