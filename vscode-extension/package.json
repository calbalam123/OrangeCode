{
  "name": "orange-code",
  "displayName": "Orange Code 한국어",
  "description": "한국어 문법 강조, UTF-8 실행 및 VS Code 디버깅을 지원하는 Orange Code",
  "version": "2.4.1",
  "publisher": "orange-code-community",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:orange"
  ],
  "contributes": {
    "languages": [
      {
        "id": "orange",
        "aliases": [
          "Orange Code",
          "오렌지코드"
        ],
        "extensions": [
          ".orange"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "orange",
        "scopeName": "source.orange",
        "path": "./syntaxes/orange.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "orange.runFile",
        "title": "Orange Code: Run File"
      },
      {
        "command": "orange.debugFile",
        "title": "Orange Code: 디버깅 시작"
      },
      {
        "command": "orange.translateFile",
        "title": "Orange Code: 파이썬 코드로 변환"
      },
      {
        "command": "orange.createFile",
        "title": "Orange Code: 새 파일 만들기"
      }
    ],
    "keybindings": [
      {
        "command": "orange.runFile",
        "key": "ctrl+shift+f5",
        "when": "editorLangId == orange"
      },
      {
        "command": "orange.debugFile",
        "key": "f5",
        "when": "editorLangId == orange"
      },
      {
        "command": "orange.translateFile",
        "key": "ctrl+alt+t",
        "when": "editorLangId == orange"
      }
    ],
    "snippets": [
      {
        "language": "orange",
        "path": "./snippets/orange.code-snippets"
      }
    ]
  },
  "scripts": {
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1"
  },
  "extensionPack": [
    "ms-python.python",
    "ms-python.debugpy"
  ]
}
